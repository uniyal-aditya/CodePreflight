# CodePreflight: the ONE env file. Copy to .env at the project root.
# Used by the backend, the frontend (Vite, VITE_ vars only) and docker compose.

# --- Supabase ---
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_KEY=replace-me            # server only, never exposed to the browser (no VITE_ prefix)

# --- Backend ---
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080   # frontend origins, comma separated
GITHUB_TOKEN=                              # optional: PUBLIC-repos-only token, used for rate limits

# --- AI explainer ---
# Adaption (Responses API): AI_PROVIDER=adaption, key from adaptionlabs.ai (Settings > API keys), model ids via GET /api/v1/models
# Any OpenAI-compatible API (Groq etc.): leave AI_PROVIDER empty and set AI_BASE_URL / AI_MODEL
AI_PROVIDER=adaption
AI_API_KEY=                                # empty = scanner text only
AI_BASE_URL=https://api.prod.adaptionlabs.ai
AI_MODEL=deepseek-v4-flash                 # confirm the id is granted to your key
MAX_REPO_MB=200                            # skip repos larger than this (clone + Trivy need memory; raise only if your plan allows)
RATE_LIMIT_PER_HOUR=10                     # audits per client IP per hour; raise for demos
# On Render/Vercel-style hosts behind a proxy also set FORWARDED_ALLOW_IPS=* so each visitor gets their own limit

# --- Frontend (public values only) ---
VITE_API_URL=                               # leave empty for the in-browser Lite scan; http://localhost:8000 for the full backend
VITE_SUPABASE_URL=                         # same as SUPABASE_URL; empty disables GitHub sign-in
VITE_SUPABASE_ANON_KEY=                    # anon (public) key only, never the service key
